    <file source-language="en" target-language="de" datatype="plaintext" original="EXT:smart_job_finder/Resources/Private/Language/locallang_be.xlf" date="2026-08-25T12:00:00Z" product-name="smart_job_finder">
        <header/>
        <body>
            <trans-unit id="extconf.notificationsEnabled" resname="extconf.notificationsEnabled">
                <source>Enable publish notifications (mail + Slack)</source>
                <target>Benachrichtigungen bei Veröffentlichung aktivieren (Mail + Slack)</target>
            </trans-unit>
            <trans-unit id="extconf.mockMode" resname="extconf.mockMode">
                <source>Mock mode: log mail and Slack payload, do not send</source>
                <target>Mock-Modus: Mail und Slack-Payload nur loggen, nicht senden</target>
            </trans-unit>
            <trans-unit id="extconf.mailTo" resname="extconf.mailTo">
                <source>Notification recipient (used when mock mode is off)</source>
                <target>Empfänger (nur wenn Mock-Modus aus ist)</target>
            </trans-unit>
            <trans-unit id="extconf.mailFrom" resname="extconf.mailFrom">
                <source>From address</source>
                <target>Absenderadresse</target>
            </trans-unit>
            <trans-unit id="extconf.slackWebhookUrl" resname="extconf.slackWebhookUrl">
                <source>Slack incoming webhook URL</source>
                <target>Slack Incoming-Webhook-URL</target>
            </trans-unit>
            <trans-unit id="extconf.jobPathPrefix" resname="extconf.jobPathPrefix">
                <source>Public job path prefix used for slug redirects (e.g. /jobs)</source>
                <target>Pfad-Prefix für Slug-Redirects (z. B. /jobs)</target>
            </trans-unit>
            <trans-unit id="extconf.apiStoragePid" resname="extconf.apiStoragePid">
                <source>Storage PID for /api/jobs (0 = 403, no instance-wide leak)</source>
                <target>Storage-PID für /api/jobs (0 = 403, kein Instanz-Leak)</target>
            </trans-unit>
            <trans-unit id="extconf.apiCorsOrigin" resname="extconf.apiCorsOrigin">
                <source>CORS origin for /api/jobs (empty = off, * or https://app.example)</source>
                <target>CORS-Origin für /api/jobs (leer = aus, * oder https://app.example)</target>
            </trans-unit>
            <trans-unit id="extconf.apiRateLimit" resname="extconf.apiRateLimit">
                <source>Max /api/jobs requests per IP per minute (0 = off)</source>
                <target>Max. /api/jobs-Requests pro IP und Minute (0 = aus)</target>
            </trans-unit>
            <trans-unit id="widget.overview.title" resname="widget.overview.title">
                <source>Smart Job Finder</source>
                <target>Smart Job Finder</target>
            </trans-unit>
            <trans-unit id="widget.overview.description" resname="widget.overview.description">
                <source>Open jobs, average Google Jobs score and new applications</source>
                <target>Offene Stellen, Google-Jobs-Score und neue Bewerbungen</target>
            </trans-unit>
            <trans-unit id="widget.overview.openJobs" resname="widget.overview.openJobs">
                <source>Open jobs</source>
                <target>Offene Stellen</target>
            </trans-unit>
            <trans-unit id="widget.overview.averageScore" resname="widget.overview.averageScore">
                <source>Average Google Jobs score</source>
                <target>Google-Jobs-Score Ø</target>
            </trans-unit>
            <trans-unit id="widget.overview.newApplications" resname="widget.overview.newApplications">
                <source>New applications</source>
                <target>Neue Bewerbungen</target>
            </trans-unit>
            <trans-unit id="widget.overview.button" resname="widget.overview.button">
                <source>Open Job Finder</source>
                <target>Job Finder öffnen</target>
            </trans-unit>
        </body>
